# --- Enable Rewrite Engine ---
RewriteEngine On

# --- 1. Smart Development Path Protection (Audit Fix) ---
# Allow individual image files to load so they appear on your site
# But redirect any attempt to browse the folder or non-file paths to home
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^olatgroup(/.*)?$ https://olatgrouplimited.co.uk/ [R=301,L]

# --- 2. Fix URL Resolve (Audit Fix) ---
# Consolidates www and non-www to prevent duplicate content penalties
RewriteCond %{HTTP_HOST} ^www\.olatgrouplimited\.co\.uk [NC]
RewriteRule ^(.*)$ https://olatgrouplimited.co.uk/$1 [L,R=301]

# --- 3. Force HTTPS (Audit Fix) ---
# Ensures secure SSL connection as required by the audit 
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- 4. Global Directory Protection ---
# Disable listing of any folder contents site-wide
Options -Indexes
DirectoryIndex index.php

# --- 5. Security Headers ---
<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    # CSP: Allows Google Fonts, FontAwesome, and internal scripts
    Header set Content-Security-Policy "default-src 'self' https: data: 'unsafe-inline' 'unsafe-eval';"
</IfModule>

# --- 6. Optimized Cache Control ---
# Addresses "Asset Performance" audit warnings
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|jpg|jpeg|png|gif|svg|ico|webp|woff2?)$">
        Header set Cache-Control "public, max-age=2592000, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

# --- 7. Critical Security Blocks ---
# Blocks access to system logic and sensitive files
RewriteRule ^config/ - [F,L]
RewriteRule ^data/ - [F,L]
RewriteRule ^PHPMailer/ - [F,L]
RewriteRule ^(\.gitignore|\.htaccess|composer\.json|package\.json)$ - [F,L]

# --- 8. Clean URLs & .php Redirection ---
# Redirects /about.php to /about for a cleaner SEO profile
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# Internally maps clean URLs back to .php files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# --- 9. Admin Protection ---
RewriteRule ^admin/$ - [F,L]